{
  "name": "@redwert/effector-openapi-preset",
  "version": "0.4.0",
  "description": "Generate API layer from Swagger by openapi",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "lint": "oxlint",
    "example": "openapi --config ./example/.openapi.config.js && yarn prettier --write ./example && oxlint --fix ./example",
    "prepare": "husky"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["index.js", "lib", "src", "!*.test.js"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redwert/effector-preset.git"
  },
  "keywords": ["swagger", "js", "openapi", "preset"],
  "author": "Sergey Sova <mail@sergeysova.com> (https://sova.dev/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/redwert/effector-preset/issues"
  },
  "homepage": "https://github.com/redwert/effector-preset#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "effector": "^23.4.4",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-snapshot": "^30.4.1",
    "lint-staged": "^17.3.0",
    "openapi": "^1.0.1",
    "oxlint": "^1.77.0",
    "prettier": "^3.9.6",
    "typed-contracts": "^2.3.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/generator": "^7.29.8",
    "@babel/template": "^7.29.7",
    "@babel/types": "^7.29.8",
    "change-case": "^4.1.2"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
